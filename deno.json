{
  "tasks": {
    "build": "deno run --allow-env --allow-run --allow-read --allow-write build.ts",
    "dev-server": "deno run --watch --allow-read --allow-write --allow-run --allow-net src/web/serve.ts",
    "file-db": "deno run --allow-read --allow-write --allow-net --allow-run --allow-sys src/file-db.ts",
    "serve": "deno run --allow-read --allow-write --allow-run --allow-net src/web/serve.ts",
    "test": "deno test --watch --allow-env --allow-read --allow-write --allow-run",
    "test-once": "deno test --allow-env --allow-read --allow-write --allow-run",
    "update-test-snapshots": "deno test --allow-env --allow-read --allow-write --allow-run -- --update"
  },
  "imports": {
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/testing": "jsr:@std/testing@^1.0.15",
    "date-fns": "npm:date-fns@^4.1.0",
    "esbuild": "npm:esbuild@0.20.2"
  }
}
