{
  "tasks": {
    "build": "deno run --allow-run build.ts",
    "dev-server": "deno run --watch --allow-read --allow-write --allow-run --allow-net src/web/serve.ts",
    "file-db": "deno run --allow-read --allow-write --allow-run --allow-sys src/file-db.ts",
    "serve": "deno run --allow-read --allow-write --allow-run --allow-net src/web/serve.ts",
    "test": "deno test --watch --allow-read --allow-write --allow-run",
    "test-once": "deno test --allow-read --allow-write --allow-run",
    "update-test-snapshots": "deno test --allow-read --allow-write -- --update"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}
